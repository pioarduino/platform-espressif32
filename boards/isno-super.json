{
  "name": "ISNO Super",
  "vendor": "ISNO",
  "url": "https://hub.isno.fr",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
      [
        "0x303A",
        "0x1001"
      ]
    ],
    "arduino": {
      "partitions": "default_8MB.csv"
    },
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DISNO_BOARD=\"ISNO Super\"",
      "-DISNO_SUPER=1",
      "-DISNO_LED=26",
      "-DISNO_BUTTON=0",
      "-DISNO_I2C_SDA=12",
      "-DISNO_I2C_SCL=13",
      "-DISNO_SPI_SCK=4",
      "-DISNO_SPI_MISO=5",
      "-DISNO_SPI_MOSI=6",
      "-DISNO_RF868_CS=7",
      "-DISNO_RF868_GDO0=1",
      "-DISNO_RF868_GDO2=2",
      "-DISNO_RF433_CS=15",
      "-DISNO_RF433_GDO0=10",
      "-DISNO_RF433_GDO2=11",
      "-DISNO_MIKROBUS_AN=8",
      "-DISNO_MIKROBUS_RST=40",
      "-DISNO_MIKROBUS_CS=34",
      "-DISNO_MIKROBUS_SCK=36",
      "-DISNO_MIKROBUS_MISO=37",
      "-DISNO_MIKROBUS_MOSI=35",
      "-DISNO_MIKROBUS_PWM=38",
      "-DISNO_MIKROBUS_INT=39"
    ]
  },
  "upload": {
    "flash_size": "8MB",
    "maximum_ram_size": 327680,
    "maximum_size": 8388608,
    "require_upload_port": true,
    "speed": 460800
  },
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": [
      "esp-builtin"
    ],
    "openocd_target": "esp32s3.cfg"
  }
}
